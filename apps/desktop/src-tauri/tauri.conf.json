{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polyglot Live Translator",
  "version": "1.0.0",
  "identifier": "com.bakele.polyglotlive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Polyglot Live Translator",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      },
      {
        "label": "subtitles",
        "title": "Sous-titres Polyglot Live",
        "url": "subtitle.html",
        "width": 900,
        "height": 190,
        "minWidth": 420,
        "minHeight": 120,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "BAKELE",
    "shortDescription": "Traduction et sous-titrage audio/vidéo en temps réel",
    "longDescription": "Application Windows et extension Chrome/Edge de transcription, traduction et sous-titrage en temps réel.",
    "windows": { "nsis": { "displayLanguageSelector": true } }
  }
}
